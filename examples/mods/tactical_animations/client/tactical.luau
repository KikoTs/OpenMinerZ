-- Weapon sway, bob, breathing, recoil and the eased aim, weighted per family.
local FAMILIES = { Pistol = { sway = 0.5, bob = 0.4, roll = 0.4, recoil = 0.3, weight = 0.7 }, LaserPistol = { sway = 0.48, bob = 0.38, roll = 0.35, recoil = 0.18, weight = 0.8 }, SMG = { sway = 0.55, bob = 0.45, roll = 0.45, recoil = 0.28, weight = 0.9 }, LaserSMG = { sway = 0.52, bob = 0.42, roll = 0.4, recoil = 0.2, weight = 1 }, Gun = { sway = 0.6, bob = 0.45, roll = 0.45, recoil = 0.3, weight = 1 }, LaserGun = { sway = 0.55, bob = 0.42, roll = 0.4, recoil = 0.2, weight = 1.1 }, Rifle = { sway = 0.62, bob = 0.4, roll = 0.4, recoil = 0.42, weight = 1.2 }, LaserRifle = { sway = 0.6, bob = 0.38, roll = 0.35, recoil = 0.25, weight = 1.3 }, PumpShotgun = { sway = 0.62, bob = 0.48, roll = 0.45, recoil = 0.45, weight = 1.2 }, LaserShotgun = { sway = 0.58, bob = 0.42, roll = 0.4, recoil = 0.3, weight = 1.25 }, LMG = { sway = 0.7, bob = 0.4, roll = 0.35, recoil = 0.25, sprint = 0.6, weight = 1.65 }, RPG = { sway = 0.65, bob = 0.4, roll = 0.35, recoil = 0.2, sprint = 0.55, weight = 1.6 }, Pick = { sway = 0.35, bob = 0.35, roll = 0.3, recoil = 0, weight = 0.8 }, Grenade = { sway = 0.4, bob = 0.35, roll = 0.3, recoil = 0, weight = 0.75 } }

local function apply_motion()
	if not mod.config.get("motion") then
		gunfx.motion(nil)
		return
	end
	local k = mod.config.get("motion_strength")
	local families = {}
	for name, values in FAMILIES do
		local scaled = {}
		for key, value in values do
			scaled[key] = if key == "weight" then value else value * k
		end
		families[name] = scaled
	end
	gunfx.motion({
		sway = k, bob = k, roll = k, sprint = k, jump = 0.55 * k, breathe = 0.4 * k, recoil = k, switch = 0.65 * k,
		aim_ease = 1, aim_damping = 0.3, weight = 1,
		families = families,
	})
end

apply_motion()
events.on("config.changed", function(event)
	if event.mod == mod.id then
		apply_motion()
	end
end)
