# The Ember UI theme example: a client mod (works on any server, vanilla too).
id=ui_theme
version=1.0.1
scope=client
protocol=both
order=600
name=Ember Theme
author=OpenMinerZ examples
description=A warm, dark restyle of the menus and HUD: colours, a pixel font, framed panels and buttons, a cursor, menu sounds, a day clock on the HUD and a pause-menu row.
api=1
