    --- @param options {one_way}
    --- Runs on: server. Usable by: server mods (server VM).
    set_relation: (team: string, other: string, relation: string, options: { [any]: any }?) -> (),
}

--- Replace the world generator: biomes, layout, caves, ores, trees
declare terrain: {
    --- Whether a mod world generator shapes this session's terrain.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    active: () -> boolean,
    --- Defines a biome for a world generator (server and core mods, in shared/). Fields: name, like
    --- (the retail biome the engine treats it as: sky, water; default classic), height (expression:
    --- world Y of the ground), density (3D expression) with overhang (blocks it may move the ground:
    --- arches, overhangs, floating islands), surface ({{block, depth}, ...} top down; default grass
    --- over 3 dirt), underwater (layers where the ground is below the sea), filler (default rock),
    --- fluid (fills open cells under the sea level: ice, surface_lava), caves (false, or {tunnels,
    --- scale, threshold, width, y = {min, max}, breach_surface}), ores ({{block, inside, chance, size,
    --- spacing, y}}), trees ({{shape = retail|round|cone|column|dead|boulder, chance, height = {min,
    --- max}, radius, thick, trunk, leaves, on}}), retail ("world" or a retail biome: reuse retail
    --- terrain), and for clients atmosphere (atmosphere.push values) and music (a track or {track,
    --- volume}).
    --- @param name Short name or "mod:name".
    --- @param definition The biome.
    --- @return The biome key.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    biome: (name: string, definition: { [any]: any }) -> string,
    --- Every biome the session's mods defined (keys).
    --- @return Keys.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    biomes: () -> { any },
    --- Replaces the world generator (one mod per world; server and core mods, in shared/). Fields:
    --- layout = {by = "distance" or an expression, warp (expression added to the distance: ragged band
    --- edges), beyond = mirror | repeat | extend (past the last band; default mirror like retail's
    --- fold), period (default the last band's `to`), bands = {{to, biome | layout, blend}, ...}},
    --- sea_level (world Y, default 1), spawn = {x, z}, origin_tower (default true), bedrock_depth (0-8,
    --- default 3). Biomes are terrain.biome names, "retail" (the whole retail generator) or
    --- "retail:classic" ... "retail:descent". Saved worlds remember the generator: a world made without
    --- it keeps retail terrain.
    --- @param definition The world.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    define: (definition: { [any]: any }) -> (),
    --- What the generator makes of a column, without loading it: biome (key), height (world Y of the
    --- ground before caves), like (retail biome) and weights ({{biome, weight}} where biomes blend).
    --- Nil when retail terrain runs.
    --- @param x World X.
    --- @param z World Z.
    --- @return {biome, height, like, weights} or nil.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    info: (x: number, z: number) -> { [any]: any }?,
}

--- Day counter and time of day
declare time: {
