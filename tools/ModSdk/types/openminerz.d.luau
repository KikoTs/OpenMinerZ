--- Particle effects
declare fx: {
    --- Names of the built-in effect recipes.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    builtins: () -> { any },
    --- Defines an effect recipe from a table (emitters, lights, shake, flash; the fields of
    --- vfx::EffectDesc). Returns its full name "<mod>:<name>".
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    define: (name: string, recipe: { [any]: any }) -> string,
    --- Moves a playing effect (streams are laid along the path).
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    move: (effect: Handle, position: Vec3Like, velocity: Vec3Like?) -> boolean,
    --- Plays an effect at a position: one of this mod's recipes, "mod:name", or a built-in
    --- (fx.builtins()). Options: direction, velocity, scale, intensity, tint, attach, offset. Returns
    --- nil in the Original presentation, which has no effects layer. Spawned before a world's first
    --- frame, the effect waits for it (up to ten seconds; dropped then if the presentation has no
    --- effects layer).
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    spawn: (recipe: string, position: Vec3Like, options: { [any]: any }?) -> Handle,
    --- Stops an effect emitting; immediate=true also removes what it already emitted.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    stop: (effect: Handle, immediate: boolean?) -> boolean,
}

--- Weapon parts, clip cues and first-person weapon motion
declare gunfx: {
    --- Drops this mod's gunfx parts, cues and motion.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    clear: () -> (),
    --- Timed cues for a player clip ("GunReload", a variant "PistolReloadEmpty" or
    --- "PumpShotgunReload@rpg"): a list of {time= (seconds of your clip, stretched with a reload) or
    --- at= (0..1), and one of sound=, show=, hide=, attach= (with bone=), detach= (blend=), drop=
    --- (velocity=, spin=, life=), kick= {pitch=, yaw=, roll=, seconds=}; volume=, pitch=,
    --- volume_jitter=, pitch_jitter=, who="all"|"self"|"others"}. Options: model= (only with that model
    --- in hand), mute= (retail cues not played for it), length=, remote_volume=0.6, remote_distance=24.
    --- Your own cues play in first person, other players' at their hands; a clip cut short stops its
    --- sounds.
    --- @param clip the clip's registered name
    --- @param cues the cues
    --- @param options model, mute, length, remote_volume, remote_distance
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    events: (clip: string, cues: { any }, options: { [any]: any }?) -> (),
    --- Turns on MW-style procedural first-person weapon motion: multipliers (1 = default, 0 = off)
    --- sway=, bob=, roll=, sprint=, jump=, breathe=, recoil=, switch=, aim_ease= (0..1), aim_damping=
    --- (0..1, kept while aimed, 0.3), weight= (heavier = slower), and families={Pistol={...},
    --- LMG={...}, ...} per weapon family. The camera and the aim are untouched; Reduced motion turns it
    --- down. nil turns it off.
    --- @param settings the multipliers
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    motion: (settings: { [any]: any }?) -> (),
    --- Cuts named parts out of a retail held-item model ("ak", "pistol", ...; "classic/ak" or
    --- "modern/ak" for one generation), from the player's own installed content, so clips can move
    --- them: a list of {name=, box={min=,max=} or boxes={...}, exclude={...}, mesh=, islands=, copy=,
    --- model=, pivot=, rotation=, scale=, hidden=}, boxes in the model's own space (barrel along -X, up
    --- +Z, right +Y; 1 unit = 1 block). Earlier parts claim triangles first. Nodes named after a part
    --- in a clip file animate it. Presentation only.
    --- @param model a retail held model name
    --- @param parts a list (or map) of part tables
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    parts: (model: string, parts: any) -> (),
}

--- Key bindings for mod actions
declare input: {
    --- Gives the action "<mod>.<action>" a default key and a handler run when it is pressed in the
    --- world. A key the game uses, or one an earlier mod has, is never taken: the binding is listed as
    --- in conflict until the player gives it a key (Options > Controls, or Add-Ons > Add-On Key
    --- Bindings). {label=} names it there.
    --- @param action a name for the action
    --- @param key the default key ("J", "F6", "Keypad 1"), or nil for none
    --- @param handler called with the action's name
    --- @param options {label=}
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    bind: (action: string, key: string?, handler: (...any) -> ...any, options: { [any]: any }?) -> (),
    --- The key one of this mod's actions has now, or nil.
    --- @param action its name
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    key: (action: string) -> string,
    --- Removes one of this mod's actions.
    --- @param action its name
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    unbind: (action: string) -> (),
}

--- Define new items (with a retail fallback)
declare items: {
    --- Defines a mod item. `fallback` (a retail item this game has) is what inventories, saves and
    --- stock messages hold; its stack limit caps `stack`. Fields: name, description, fallback, icon,
    --- model (a glTF drawn in the hand and on the ground; without one the icon is, as a thin solid
    --- sprite), scale (its size there, 1), hold (fallback, item, swing, tool, block, fist, eat or
    --- drink: the arm clips and the grip), stack, places (a mod block of the same fallback), cooldown,
    --- weapon = {damage, player_damage, reach, cooldown} (melee stats the host checks every swing
    --- against; the fallback must be an item that strikes), use = function(player, key, target)
    --- (server; runs instead of the fallback's own action; target is item.used's aimed block or nil).
    --- @param name Short name or "mod:name".
    --- @param definition The item.
    --- @return The full key.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    define: (name: string, definition: { [any]: any }) -> string,
    --- A mod item's definition.
    --- @param key Item key.
    --- @return {key, name, description, fallback, icon, model, hold, stack, weapon} or nil (weapon:
    --- {damage, player_damage, reach, cooldown} or nil).
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    get: (key: string) -> { [any]: any }?,
    --- Every mod item key.
    --- @return Keys.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    list: () -> { any },
}

--- Coloured point and spot lights
declare light: {
    --- Makes a light follow an entity or player: offset in its frame, turned with its yaw unless
    --- rotate=false. The light goes dark while the target is gone.
    --- @param target entity or player
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    attach: (light: Handle, target: Handle, offset: Vec3Like?, rotate: boolean?) -> (),
    --- Lights this mod has placed.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    count: () -> number,
    --- Places a light: {position=, color=, intensity=1, radius=8, flicker=0, flicker_speed=9, pulse=0,
    --- pulse_speed=1, shape="point"|"spot", direction=, inner_angle=25, outer_angle=40, enabled=true}.
    --- Lights terrain, creatures, models and the first-person body in both presentations; a world can
    --- hold 4096 (1024 per mod) and the 256 most important in view are drawn.
    --- @param desc the light
    --- @return the light, or nil when the limit is reached
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    create: (desc: { [any]: any }) -> Handle?,
    --- Stops following; the light stays where it is.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    detach: (light: Handle) -> (),
    --- Switches a light on or off.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    enable: (light: Handle, on: boolean) -> (),
    --- Removes a light.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    remove: (light: Handle) -> boolean,
    --- Changes some fields of a light (the same fields as light.create).
    --- @param desc fields to change
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    set: (light: Handle, desc: { [any]: any }) -> (),
}

--- Write to the game log, tagged with your mod's id
declare log: {
    --- Writes its arguments, separated by spaces, to the game log at debug level, tagged with the mod's
    --- id.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    debug: (...any) -> (),
    --- Writes its arguments, separated by spaces, to the game log at error level, tagged with the mod's
    --- id.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    error: (...any) -> (),
    --- Writes its arguments, separated by spaces, to the game log at info level, tagged with the mod's
    --- id.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    info: (...any) -> (),
    --- Writes its arguments, separated by spaces, to the game log at warn level, tagged with the mod's
    --- id.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    warn: (...any) -> (),
}

--- Loot tables for crates, enemies and drops
declare loot: {
    --- Defines a loot table: {rolls = n or {min, max}, entries = {{item, weight, min, max}}}.
    --- @param name Short name or "mod:name".
    --- @param table The table.
    --- @return The full key.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    define: (name: string, table: { [any]: any }) -> string,
    --- Rolls a loot table and drops the result as pickups.
    --- @param table Loot table.
    --- @param position Where.
    --- @return Stacks dropped.
    --- Runs on: server. Usable by: server mods (server VM).
    drop: (table: string, position: Vec3Like) -> number,
    --- Adds a loot table to what a retail enemy drops when the player this process simulates kills it
    --- (retail drops are unchanged).
    --- @param enemy zombie, archer, skeleton, felguard, alien, any, or a type id.
    --- @param table Loot table.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    enemy: (enemy: any, table: string) -> (),
    --- Rolls a loot table into a crate's empty slots.
    --- @param table Loot table.
    --- @param position The crate.
    --- @return Stacks placed.
    --- Runs on: server. Usable by: server mods (server VM).
    fill_crate: (table: string, position: Vec3Like) -> number,
    --- Rolls a loot table.
    --- @param table Loot table.
    --- @return {item, count} entries.
    --- Runs on: server. Usable by: server mods (server VM).
    roll: (table: string) -> { any },
}

--- Your mod's id, version, side, settings and what it may call
declare mod: {
    --- Whether this mod may call an API function here (it exists, runs on this side, and the mod has
    --- its capability).
    --- @param name a dotted name such as "world.set_block"
    --- @return true when calling it would not be refused
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    has: (name: string) -> boolean,
    --- This mod's id.
    --- @return the id from openminerz.mod
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    id: () -> string,
    --- Whether another mod is loaded and running on this side.
    --- @param id a mod id
    --- @return true when it runs here
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    loaded: (id: string) -> boolean,
    --- Where this script runs.
    --- @return "server" or "client"
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    side: () -> string,
    --- This mod's version.
    --- @return the version from openminerz.mod
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    version: () -> string,
    config: {
        --- Declares a setting the player can change on the mod's settings page. Call it from shared/ so
        --- both sides know it.
        --- @param key 1-64 characters: letters, digits, _ . -
        --- @param spec {type = "boolean"|"integer"|"number"|"string", default = value, label, description,
        --- min, max, step, choices = {"a", "b"}}
        --- @return the setting's current value
        --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
        define: (key: string, spec: { [any]: any }) -> any,
        --- Reads one of this mod's settings.
        --- @param key a key passed to mod.config.define
        --- @return its current value
        --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
        get: (key: string) -> any,
    },
}

--- glTF models placed in the world
declare model: {
    --- The animation clips of a model file.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    clips: (model: string) -> { any },
    --- Plays one of the model's animation clips from its start.
    --- @param options loop, speed
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    play: (model: Handle, clip: string, options: { [any]: any }?) -> (),
    --- Removes a placed model.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    remove: (model: Handle) -> boolean,
    --- Changes a placed model (the options of model.spawn, and position).
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    set: (model: Handle, options: { [any]: any }) -> (),
    --- Places a glTF model ("models/lantern") at a position. Options: yaw, pitch, roll (degrees),
    --- scale, tint, animation, loop, speed, visible, attach, offset.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    spawn: (model: string, position: Vec3Like, options: { [any]: any }?) -> Handle,
}

--- Play and crossfade music
declare music: {
    --- Plays a music track ("music/theme", streamed .ogg or .wav), crossfading from what plays.
    --- Options: crossfade=2, volume=1, loop=true. Follows the Music volume.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    play: (track: string, options: { [any]: any }?) -> boolean,
    --- Fades the mod music out.
    --- Runs on: client. Usable by: client mods, server mods (client VM).
    stop: (fade: number?) -> (),
}

--- Messages between the server and clients (RPC)
declare net: {
    --- Sends a message to every ready player's `net.on(name, ...)` handler of this mod.
    --- @param name Message name (1-64 letters, digits, _ . : - /), private to this mod.
    --- @param payload Any value without functions; tables nest up to 8 levels (client) or 16 (host).
    --- @return how many players were addressed
    --- Runs on: server. Usable by: server mods (server VM).
    broadcast: (name: string, payload: any) -> number,
    --- Whether the host's initial replicated snapshot has arrived (see the net.ready event).
    --- Runs on: client. Usable by: server mods (client VM).
    is_ready: () -> boolean,
    --- This client's player handle, as the host knows it (nil before the host's welcome).
    --- @return the local player, or nil
    --- Runs on: client. Usable by: server mods (client VM).
    local_player: () -> Handle?,
    --- Removes this mod's handler for `name`.
    --- @param name Message name (1-64 letters, digits, _ . : - /), private to this mod.
    --- Runs on: server and client. Usable by: server mods (both VMs).
    off: (name: string) -> (),
    --- Handles messages `name` of this mod. On the host the handler is called as fn(player, payload)
    --- with the sending player (taken from the connection, never from the payload); on a client as
    --- fn(payload). With a schema (field -> "number", "string?", {type="integer", min=0, max=9}, ...),
    --- payloads that do not match are dropped and logged before the handler runs. Replaces an earlier
    --- handler.
    --- @param name Message name (1-64 letters, digits, _ . : - /), private to this mod.
    --- @param handler The handler.
    --- @param schema Expected payload fields.
    --- Runs on: server and client. Usable by: server mods (both VMs).
    on: (name: string, handler: (...any) -> ...any, schema: { [any]: any }?) -> (),
    --- Players whose mod channel is ready, in join order.
    --- @return player handles
    --- Runs on: server. Usable by: server mods (server VM).
    players: () -> { any },
    --- Sends a message to the host's `net.on(name, ...)` handler of this mod. Queued and paced under
    --- the host's rate limits; returns false when the outgoing queue is full.
    --- @param name Message name (1-64 letters, digits, _ . : - /), private to this mod.
    --- @param payload Any value without functions; tables nest up to 8 levels (client) or 16 (host).
    --- @return true when queued
    --- Runs on: client. Usable by: server mods (client VM).
    send: (name: string, payload: any) -> boolean,
    --- Sends a message to one player's `net.on(name, ...)` handler of this mod.
    --- @param player The receiving player.
    --- @param name Message name (1-64 letters, digits, _ . : - /), private to this mod.
    --- @param payload Any value without functions; tables nest up to 8 levels (client) or 16 (host).
    --- @return false when the player has no mod channel
    --- Runs on: server. Usable by: server mods (server VM).
    send_to: (player: Handle, name: string, payload: any) -> boolean,
}

--- Noise expressions the world generator evaluates natively
declare noise: {
    --- The absolute value.
    --- @param a A number or an expression.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    abs: (a: any) -> { [any]: any },
    --- The sum of its arguments (numbers or expressions).
    --- @param a A number or an expression.
    --- @param b More of them.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    add: (a: any, b: any, ...any) -> { [any]: any },
    --- Billowy noise in -1..1: rounded bumps and sharp creases (dunes, clouds). Options: scale (blocks
    --- per feature, default 64), octaves (1-10, default 4), gain (default 0.5), lacunarity (default 2),
    --- seed, three_d (true: varies with Y too), vertical_scale (3D, blocks per feature along Y).
    --- @param options See above.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    billow: (options: { [any]: any }?) -> { [any]: any },
    --- Cellular (Worley) noise. Options: scale, seed, jitter (0..1), three_d, mode: "distance" (to the
    --- nearest point, about 0..1), "edge" (0 on cell borders: cracks, plates), "cell" (a random 0..1
    --- per cell: patches).
    --- @param options See above.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    cellular: (options: { [any]: any }?) -> { [any]: any },
    --- Limits a value to low..high.
    --- @param a A number or an expression.
    --- @param low Lowest.
    --- @param high Highest.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    clamp: (a: any, low: number, high: number) -> { [any]: any },
    --- Maps a value through points {{input, output}, ...} (increasing inputs; flat outside them),
    --- straight between points or, with smooth = true, a smooth spline: terraces, plateaus, cliffs.
    --- @param a A number or an expression.
    --- @param points {{in, out}, ...}
    --- @param smooth A spline instead of straight segments.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    curve: (a: any, points: { any }, smooth: boolean?) -> { [any]: any },
    --- Distance from the origin (sqrt(x^2 + z^2)).
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    distance: () -> { [any]: any },
    --- Smooth fractal noise in -1..1: hills, plains, climate. Options: scale (blocks per feature,
    --- default 64), octaves (1-10, default 4), gain (default 0.5), lacunarity (default 2), seed,
    --- three_d (true: varies with Y too), vertical_scale (3D, blocks per feature along Y).
    --- @param options See above.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    fbm: (options: { [any]: any }?) -> { [any]: any },
    --- a + (b - a) * t: blends two expressions.
    --- @param a At t = 0.
    --- @param b At t = 1.
    --- @param t The blend.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    lerp: (a: any, b: any, t: any) -> { [any]: any },
    --- The largest of its arguments.
    --- @param a A number or an expression.
    --- @param b More of them.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    max: (a: any, b: any, ...any) -> { [any]: any },
    --- The smallest of its arguments.
    --- @param a A number or an expression.
    --- @param b More of them.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    min: (a: any, b: any, ...any) -> { [any]: any },
    --- The product of its arguments.
    --- @param a A number or an expression.
    --- @param b More of them.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    mul: (a: any, b: any, ...any) -> { [any]: any },
    --- Ridged noise in 0..1: sharp crests where fbm crosses zero (mountain ridges). Options: scale
    --- (blocks per feature, default 64), octaves (1-10, default 4), gain (default 0.5), lacunarity
    --- (default 2), seed, three_d (true: varies with Y too), vertical_scale (3D, blocks per feature
    --- along Y).
    --- @param options See above.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    ridged: (options: { [any]: any }?) -> { [any]: any },
    --- Evaluates an expression at a point with this world's seed, natively: the value the generator
    --- sees there.
    --- @param expression A number or an expression.
    --- @param x World X.
    --- @param z World Z.
    --- @param y World Y (3D expressions).
    --- @return The value.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    sample: (expression: any, x: number, z: number, y: number?) -> number,
    --- Chooses between two expressions by a selector: `low` where the selector is under `from`, `high`
    --- above `to`, blended between.
    --- @param selector A number or an expression.
    --- @param low Below `from`.
    --- @param high Above `to`.
    --- @param from Where the blend starts.
    --- @param to Where it ends (greater than from).
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    select: (selector: any, low: any, high: any, from: number, to: number) -> { [any]: any },
    --- a - b.
    --- @param a A number or an expression.
    --- @param b Subtracted.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    sub: (a: any, b: any) -> { [any]: any },
    --- World X of the point.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    x: () -> { [any]: any },
    --- World Y of the point (0 in a 2D expression such as a height).
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    y: () -> { [any]: any },
    --- World Z of the point.
    --- @return A noise expression.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    z: () -> { [any]: any },
}

--- Players: health, position, inventory, messages
declare players: {
    --- A system chat line for everyone.
    --- @param text The line.
    --- Runs on: server. Usable by: server mods (server VM).
    broadcast: (text: string) -> (),
    --- The player with a gamer tag.
    --- @param name Gamer tag.
    --- @return Player handle or nil.
    --- Runs on: server. Usable by: server mods (server VM).
    by_name: (name: string) -> Handle?,
    --- Empties a player's inventory.
    --- @param player A player handle.
    --- Runs on: server. Usable by: server mods (server VM).
    clear_inventory: (player: Handle) -> (),
    --- How many of an item a player carries (a remote player's last report).
    --- @param player A player handle.
    --- @param item Item name, mod key or retail id.
    --- @return Count.
    --- Runs on: server. Usable by: server mods (server VM).
    count: (player: Handle, item: any) -> number,
    --- Damages a player through the game's own damage path.
