declare projectiles: {
    --- Defines a projectile creatures (attacks = {x = {projectile = name}}) and scripts launch. Fields:
    --- speed (blocks/s), gravity (blocks/s^2 down), lifetime, radius, damage (player health, 100 =
    --- full), creature_damage (default damage / 10), homing (degrees/s it turns toward its target),
    --- model / texture / scale (drawn along its flight; a glTF, or retail:arrow-style refs where the
    --- content exists), fx (a trail effect that follows it), impact_fx (an effect where it lands; with
    --- an explosion it stands for the game's own blast), pierce, explosion = {radius, damage, blocks
    --- (dig blocks out where the session's rules let monsters break them)}, breaks_blocks (the mod's
    --- own choice, whatever the difficulty: the explosion digs, or without one the block struck breaks;
    --- never inside spawn protection, decided by the host), on_hit = function(projectile, hit).
    --- @param name Short name or "mod:name".
    --- @param definition The projectile.
    --- @return The full key.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    define: (name: string, definition: { [any]: any }) -> string,
    --- Launches a projectile from a point. `toward` is a position, player or entity it is aimed at
    --- (leading a moving creature and arcing for gravity), or use options.velocity. Options: owner (an
    --- entity or player: its team's friends are spared and kills are credited), velocity, damage_scale.
    --- @param kind Projectile key.
    --- @param from Start.
    --- @param toward Position, player or entity.
    --- @param options {owner, velocity, damage_scale}
    --- @return The projectile, or nil (at the limit, or nowhere to aim).
    --- Runs on: server. Usable by: server mods (server VM).
    launch: (kind: string, from: Vec3Like, toward: any, options: { [any]: any }?) -> Handle?,
    --- Projectiles in flight, optionally within a radius of a point.
    --- @param options {near, radius, kind}
    --- @return {projectile, kind, position, velocity} entries.
    --- Runs on: server. Usable by: server mods (server VM).
    list: (options: { [any]: any }?) -> { any },
    --- Removes a projectile in flight (no hit).
    --- @param projectile The projectile.
    --- Runs on: server. Usable by: server mods (server VM).
    remove: (projectile: Handle) -> (),
}

