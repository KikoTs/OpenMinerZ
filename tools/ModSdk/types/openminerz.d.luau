declare enemies: {
    --- Whether the rules let a retail enemy family appear at a position.
    --- @param family zombie, skeleton, archer, felguard, alien, dragon, spawner or hell.
    --- @param position Where.
    --- @return Allowed.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    allowed: (family: string, position: Vec3Like) -> boolean,
    --- The retail enemy rules in effect (the host's, on a client).
    --- @return {active, enabled, families = {zombie = true, ...}, distance = {scale, offset, max},
    --- regions, clear_existing}.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    get_rules: () -> { [any]: any },
    --- Back to the retail enemies, exactly as the game spawns them.
    --- Runs on: server. Usable by: server mods (server VM).
    reset: () -> (),
    --- Rules for the RETAIL enemies of the whole session (every peer spawns its own player's enemies;
    --- every peer applies these). Fields: enabled (false: no retail enemies at all), family switches
    --- zombie, skeleton, archer, felguard, alien, dragon, spawner (1.9.9.8 spawner blocks), hell
    --- (anything below y -40, hell spawners), distance = {scale, offset, max} (the distance retail
    --- picks zombie tiers, skeleton kinds, dragons and spawn pace by: distance * scale + offset, at
    --- most max - for a world wider than retail's), regions = {{min = vector, max = vector (x/z box),
    --- y_min, y_max, biome (a biome key, mod biomes too), enabled, zombie = ..., tier (a fixed tier
    --- distance)}, ...} (later regions win), clear_existing (true: the retail enemies already about
    --- that the rules switch off leave, as retail's own give-up sends them, without drops, on every
    --- peer; default false: only spawns from now on follow the rules). A spawner block whose waves
    --- could only bring switched-off families stays silent (no start, no reward); in one that runs,
    --- members of a switched-off family never appear and count as defeated. A joined player spawns no
    --- retail enemy until these rules reach it. Never reaches a stock player: server mods only run
    --- where none can join.
    --- @param rules The rules.
    --- Runs on: server. Usable by: server mods (server VM).
    rules: (rules: { [any]: any }) -> (),
}

