    get: (player: Handle) -> { [any]: any },
    --- Gives a player items (what does not fit is dropped at its feet).
    --- @param player A player handle.
    --- @param item Item name, mod key or retail id.
    --- @param count How many (default 1).
    --- @return How many were given.
    --- Runs on: server. Usable by: server mods (server VM).
    give: (player: Handle, item: any, count: number?) -> number,
    --- Heals a player (up to 100).
    --- @param player A player handle.
    --- @param amount Health points.
    --- Runs on: server. Usable by: server mods (server VM).
    heal: (player: Handle, amount: number) -> (),
    --- A player's health (0-100; a remote player's last report).
    --- @param player A player handle.
    --- @return Health.
    --- Runs on: server. Usable by: server mods (server VM).
    health: (player: Handle) -> number,
    --- The stack in a player's hand (the local player only).
    --- @param player A player handle.
    --- @return {item, count} or nil.
    --- Runs on: server. Usable by: server mods (server VM).
    held: (player: Handle) -> { [any]: any }?,
    --- Every player in the session.
    --- @return Player handles.
    --- Runs on: server. Usable by: server mods (server VM).
    list: () -> { any },
    --- The player this machine plays: {position (feet), eye, look (view direction), yaw, pitch, health,
    --- alive, target = {position, face} of the block the game's selection aims at, liquid (the first
    --- liquid cell the look passes within reach), in_liquid, underwater}. nil outside a world. Works
    --- for client mods on any server.
