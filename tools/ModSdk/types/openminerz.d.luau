    set: (time_of_day: number) -> (),
}

--- Run a function later, or every few seconds
declare timer: {
    --- Calls `callback` once, `seconds` from now.
    --- @param seconds delay; server timers count simulation ticks, client timers frames
    --- @param callback called with no arguments
    --- @return the timer, for timer.cancel
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    after: (seconds: number, callback: (...any) -> ...any) -> Handle,
    --- Stops one of this mod's timers.
    --- @param timer from timer.after or timer.every
    --- @return true when it was still pending
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    cancel: (timer: Handle) -> boolean,
    --- Calls `callback` every `seconds` until cancelled.
    --- @param seconds delay; server timers count simulation ticks, client timers frames
    --- @param callback called with no arguments
    --- @return the timer, for timer.cancel
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    every: (seconds: number, callback: (...any) -> ...any) -> Handle,
}

