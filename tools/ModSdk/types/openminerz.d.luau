--- Server-owned state every client can read
declare replicated: {
    --- Every key of this mod in one store, as a table.
    --- @param scope "world", a player handle, or an entity handle.
    --- @return key -> value
    --- Runs on: server and client. Usable by: server mods (both VMs).
    all: (scope: any) -> { [any]: any },
    --- Removes every key of this mod from one store.
    --- @param scope "world", a player handle, or an entity handle.
    --- Runs on: server. Usable by: server mods (server VM).
    clear: (scope: any) -> (),
    --- Reads a replicated value (on a client: the last value the host sent).
    --- @param scope "world", a player handle, or an entity handle.
    --- @param key Key (1-64 letters, digits, _ . : - /), private to this mod.
    --- @return the value, or nil
    --- Runs on: server and client. Usable by: server mods (both VMs).
    get: (scope: any, key: string) -> any,
    --- Stops a replicated.on_change subscription of this mod.
    --- @param id The id replicated.on_change returned.
    --- Runs on: server and client. Usable by: server mods (both VMs).
    off: (id: number) -> (),
    --- Calls fn(value, old, key, owner) when one of this mod's replicated values changes (value nil
    --- when removed; owner nil for world values). scope is "world", "player", "entity", "any" or one
    --- handle; key nil watches every key. On a client it fires for the initial snapshot too.
    --- @param scope Which stores to watch.
    --- @param key A key, or nil for every key.
    --- @param handler fn(value, old, key, owner)
    --- @return a subscription id for replicated.off
    --- Runs on: server and client. Usable by: server mods (both VMs).
    on_change: (scope: any, key: any, handler: (...any) -> ...any) -> number,
    --- Sets (nil removes) a host-owned replicated value. World values reach every player, player values
    --- only that player unless {public = true}, entity values every interested player. Changes are sent
    --- once per tick, highest {priority = "low"|"normal"|"high"|"critical"} first within each player's
    --- bandwidth budget. Options stick to the key.
    --- @param scope "world", a player handle, or an entity handle.
    --- @param key Key (1-64 letters, digits, _ . : - /), private to this mod.
    --- @param value Any value without functions (<= 16 KiB encoded).
    --- @param options {public = boolean, priority = ...}
    --- Runs on: server. Usable by: server mods (server VM).
    set: (scope: any, key: string, value: any, options: { [any]: any }?) -> (),
}

