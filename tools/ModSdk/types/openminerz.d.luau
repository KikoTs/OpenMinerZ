--- Payload of "world.edit_done" (server). A fill/replace/structure job finished.
type WorldEditDoneEvent = {
    --- Job id.
    job: number,
    --- Cells changed.
    changed: number,
    --- The mod that queued it.
    mod: string,
}

--- Payload of "world.loaded" (server and client). The world is ready: blocks, players and storage
--- can be used.
type WorldLoadedEvent = {
    --- the world's name
    name: string?,
    --- the world's generation seed
    seed: number?,
    --- "offline", "host" or "client"
    mode: string?,
}

--- Payload of "world.unloading" (server and client). The session is ending (or a developer reload).
--- Storage is saved right after the handlers run.
type WorldUnloadingEvent = {
    --- "server" or "client"
    side: string,
}

--- Payload of "worldgen.chunk" (server). A chunk is offered for decoration (after worldgen.enable).
--- Build with structures.place / world.*; use `seed` or worldgen.random for repeatable choices.
type WorldgenChunkEvent = {
    --- Chunk X.
    cx: number,
    --- Chunk Z.
    cz: number,
    --- World X of its corner.
    x: number,
    --- World Z of its corner.
    z: number,
    --- This chunk's seed.
    seed: number,
    --- Biome at its centre.
    biome: string,
}

declare ai: {
    --- Starts one of the creature's attacks (creatures.define{attacks = {...}}) at a target (default:
    --- its own). The attack's animation starts now on every client and the hit is decided `windup`
    --- seconds later: melee strikes what is still within reach and arc, ranged fires its projectile.
    --- False when the attack is cooling down, out of range, or another one is under way.
    --- @param entity An entity whose creature has AI.
    --- @param attack Attack name.
    --- @param target Player or entity.
    --- @return Whether it started.
    --- Runs on: server. Usable by: server mods (server VM).
    attack: (entity: Handle, attack: string, target: Handle?) -> boolean,
    --- Whether the creature sees a player or entity now (range, field of view, line of sight).
    --- @param entity An entity whose creature has AI.
    --- @param target Player or entity.
    --- @return Visible.
    --- Runs on: server. Usable by: server mods (server VM).
    can_see: (entity: Handle, target: Handle) -> boolean,
    --- Closes in on a player, an entity or a point (planning around terrain). Options: distance (stop
    --- this close, default 1.5), run (default true).
    --- @param entity An entity whose creature has AI.
    --- @param target Player, entity or position.
    --- @param options {distance, run}
    --- Runs on: server. Usable by: server mods (server VM).
    chase: (entity: Handle, target: any, options: { [any]: any }?) -> (),
    --- Seconds until an attack or ability is ready (0 when it is).
    --- @param entity An entity whose creature has AI.
    --- @param name Attack or ability.
    --- @return Seconds.
    --- Runs on: server. Usable by: server mods (server VM).
    cooldown: (entity: Handle, name: string) -> number,
    --- Fires a projectile from the creature's eyes at a target, outside its attacks (no windup, no
    --- cooldown). Options: damage_scale, lead (default true).
    --- @param entity An entity whose creature has AI.
    --- @param projectile Projectile key.
    --- @param target Player, entity or position.
    --- @param options {damage_scale, lead}
    --- @return The projectile, or nil.
    --- Runs on: server. Usable by: server mods (server VM).
    fire: (entity: Handle, projectile: string, target: any, options: { [any]: any }?) -> Handle?,
    --- Runs away from a player, entity or point for `seconds` (default 4).
    --- @param entity An entity whose creature has AI.
    --- @param from Player, entity or position.
    --- @param options {seconds}
    --- Runs on: server. Usable by: server mods (server VM).
    flee: (entity: Handle, from: any, options: { [any]: any }?) -> (),
    --- Makes a creature forget a player or entity (and stop chasing it).
    --- @param entity An entity whose creature has AI.
    --- @param target Player or entity.
    --- Runs on: server. Usable by: server mods (server VM).
    forget: (entity: Handle, target: Handle) -> (),
    --- Walks back to its home (where it spawned, or ai.set_home).
    --- @param entity An entity whose creature has AI.
    --- Runs on: server. Usable by: server mods (server VM).
    go_home: (entity: Handle) -> (),
    --- Runs one step of the built-in hunter for this creature: chase or keep its distance, surround
    --- with its pack, use whichever attack fits, flee when hurt, return home past its leash,
    --- investigate what it heard, wander. Call it from a state's tick to borrow the default behaviour.
    --- @param entity An entity whose creature has AI.
    --- Runs on: server. Usable by: server mods (server VM).
    hunt: (entity: Handle) -> (),
    --- Puts a creature in another's pack (creatures spawned together by a spawn rule, or with
    --- entities.spawn{pack = other}, already are): packs share what they notice, surround a target
    --- together, and info.pack_hurt tells a brain how badly the pack is doing.
    --- @param entity An entity whose creature has AI.
    --- @param other A member of the pack to join.
    --- Runs on: server. Usable by: server mods (server VM).
    join_pack: (entity: Handle, other: Handle) -> (),
    --- Stays between `distance` and `far` blocks of a target (what archers do), facing it.
    --- @param entity An entity whose creature has AI.
    --- @param target Player, entity or position.
    --- @param options {distance, far, run}
    --- Runs on: server. Usable by: server mods (server VM).
    keep_distance: (entity: Handle, target: any, options: { [any]: any }?) -> (),
    --- What a creature knows of: every target it saw or heard and still remembers.
    --- @param entity An entity whose creature has AI.
    --- @return {target, position, visible, hostile, threat, seen (seconds ago)} entries.
    --- Runs on: server. Usable by: server mods (server VM).
    known: (entity: Handle) -> { any },
    --- Walks (flies, swims) to a point. Options: run (default false).
    --- @param entity An entity whose creature has AI.
    --- @param position Position (or a player/entity's current position).
    --- @param options {run}
    --- Runs on: server. Usable by: server mods (server VM).
    move_to: (entity: Handle, position: any, options: { [any]: any }?) -> (),
    --- Makes a noise creatures may hear: those within hearing * loudness / 16 blocks remember it (and
    --- who made it, given a player or entity). The game makes noises itself: gunshots (32), explosions
    --- (48), digging and building (8).
    --- @param position Where.
    --- @param loudness Blocks it carries at hearing 16 (default 16).
    --- @param source The player or entity that made it.
    --- Runs on: server. Usable by: server mods (server VM).
    noise: (position: Vec3Like, loudness: number?, source: Handle?) -> (),
    --- The members of a creature's pack (itself included), leader first.
    --- @param entity An entity whose creature has AI.
    --- @return Entity handles.
    --- Runs on: server. Usable by: server mods (server VM).
    pack: (entity: Handle) -> { any },
    --- A boss's phase: 0 before the first threshold, then 1, 2, ...
    --- @param entity An entity whose creature has AI.
    --- @return Phase.
    --- Runs on: server. Usable by: server mods (server VM).
    phase: (entity: Handle) -> number,
    --- Whether an attack or ability has cooled down.
    --- @param entity An entity whose creature has AI.
    --- @param name Attack or ability.
    --- @return Ready.
    --- Runs on: server. Usable by: server mods (server VM).
    ready: (entity: Handle, name: string) -> boolean,
    --- Makes a creature aware of a player or entity (as if it had heard it), hostile unless
    --- options.hostile is false. Options: threat (default 1).
    --- @param entity An entity whose creature has AI.
    --- @param target Player or entity.
    --- @param options {threat, hostile}
    --- Runs on: server. Usable by: server mods (server VM).
    remember: (entity: Handle, target: Handle, options: { [any]: any }?) -> (),
    --- Sets the point a creature returns to (and its leash's centre).
    --- @param entity An entity whose creature has AI.
    --- @param position Home.
    --- Runs on: server. Usable by: server mods (server VM).
    set_home: (entity: Handle, position: Vec3Like) -> (),
    --- Scales a creature's speed and damage from now on (boss phases do this too).
    --- @param entity An entity whose creature has AI.
    --- @param scale {speed, damage}
    --- Runs on: server. Usable by: server mods (server VM).
    set_scale: (entity: Handle, scale: { [any]: any }) -> (),
    --- Switches a creature's brain to a state (its exit and the new state's enter run).
    --- @param entity An entity whose creature has AI.
    --- @param state State name.
    --- Runs on: server. Usable by: server mods (server VM).
    set_state: (entity: Handle, state: string) -> (),
    --- Sets whom a creature is after (nil: nobody); entity.target_changed fires. It keeps the target
    --- until it loses it (memory) or something far more threatening appears.
    --- @param entity An entity whose creature has AI.
    --- @param target A player, an entity, or nil.
    --- Runs on: server. Usable by: server mods (server VM).
    set_target: (entity: Handle, target: any) -> (),
    --- Where swimmers find water: open cells whose centre is below `level` (default 1.5, the Lagoon's
    --- sea) in the listed biomes (default {"lagoon"}; "*" for every biome).
    --- @param water {level, biomes}
    --- Runs on: server. Usable by: server mods (server VM).
    set_water: (water: { [any]: any }) -> (),
    --- A creature's current brain state.
    --- @param entity An entity whose creature has AI.
    --- @return State name.
    --- Runs on: server. Usable by: server mods (server VM).
    state: (entity: Handle) -> string,
    --- AI load since the session started: thoughts, deferred thoughts, planning, time spent.
    --- @return {minds, thinks, deferred, think_ms, step_ms, paths, nodes, fields, cache_hits,
    --- sight_checks, projectiles}.
