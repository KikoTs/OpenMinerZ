-- OpenMinerZ modding API, type definitions for luau-lsp and other Luau tools.
-- API version 1. Generated by `openminerz_mod_sdk reference` from the game's own
-- registry: do not edit. Point luau-lsp at it with "luau-lsp.types.definitionFiles"
-- (see docs/modding/authoring.md).

--- An engine object: a player, entity, widget, light, effect, sound, timer or quest.
--- The same object is always the same (==) handle, so handles work as table keys.
declare class Handle
    --- "player", "entity", "widget", "light", "effect", "sound", "timer", "quest", ...
    kind: string
    --- Never reused within a session.
    id: number
    valid: boolean
end

--- Anything a vector parameter accepts: vector.create(x, y, z) or {x = , y = , z = }.
type Vec3Like = vector | { x: number, y: number, z: number }

