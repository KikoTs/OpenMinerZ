    --- the same sequence. random() is in [0, 1), random(n) in 1..n, random(m, n) in m..n.
    --- @param m upper bound, or lower bound with n
    --- @param n upper bound
    --- @return the number
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    random: (m: number?, n: number?) -> number,
    --- Turns a value into compact JSON text (vectors and nested tables included; functions and handles
    --- cannot be serialized).
    --- @param value the value
    --- @return JSON text
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    serialize: (value: any) -> string,
}

--- Read and edit blocks, raycasts, biomes, light
declare world: {
    --- The biome of a column.
    --- @param x World X.
    --- @param z World Z.
    --- @return classic, lagoon, desert, mountain, arctic, descent, or a mod biome key ("mymod:redwood")
    --- where a mod world generator runs.
