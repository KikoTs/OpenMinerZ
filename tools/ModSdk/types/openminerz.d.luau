    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    me: () -> { [any]: any }?,
    --- A system chat line for one player.
    --- @param player A player handle.
    --- @param text The line (160 characters at most).
    --- Runs on: server. Usable by: server mods (server VM).
    message: (player: Handle, text: string) -> (),
    --- A player's feet position.
    --- @param player A player handle.
    --- @return Position.
    --- Runs on: server. Usable by: server mods (server VM).
    position: (player: Handle) -> vector,
    --- Inside a player.damaged handler: changes how much damage is applied (0 = none). Works for every
    --- player when the host decides health (a session with server mods, or OpenMinerZ players only);
    --- otherwise only for the players this server simulates itself, and remote players' damage is
    --- reported after the fact.
    --- @param amount The damage to apply.
    --- Runs on: server. Usable by: server mods (server VM).
    set_damage: (amount: number) -> (),
    --- Sets a player's health (0-100).
    --- @param player A player handle.
