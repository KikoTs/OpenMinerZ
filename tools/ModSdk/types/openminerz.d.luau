--- Define, parse and place block structures
declare structures: {
    --- Defines a structure from a table: {palette = {["#"] = "rock", ["."] = "air"}, layers = {{"###",
    --- "#.#", "###"}, ...} (bottom first; rows run along +Z, characters along +X; space = leave as is),
    --- origin = {x, y, z}}.
    --- @param name Short name or "mod:name".
    --- @param definition The structure.
    --- @return Its size.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    define: (name: string, definition: { [any]: any }) -> vector,
    --- Defines a structure from the text schematic format (a mod file's contents): 'origin x y z',
    --- 'palette <char> <block>', 'layer' then rows.
    --- @param name Short name or "mod:name".
    --- @param text Schematic text.
    --- @return Its size.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    parse: (name: string, text: string) -> vector,
    --- Builds a structure with its origin at a cell: {rotation = 0/90/180/270 (about Y, +X toward +Z),
    --- air = true (whether "air" cells carve), on_done = fn(job, changed)}. The cells are ordinary
    --- world edits, spread over ticks.
    --- @param name Structure.
    --- @param position Where its origin goes.
    --- @param options Options.
    --- @return The job id.
    --- Runs on: server. Usable by: server mods (server VM).
    place: (name: string, position: Vec3Like, options: { [any]: any }?) -> number,
    --- A structure's size before rotation.
    --- @param name Structure.
    --- @return {x, y, z} size.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    size: (name: string) -> vector,
}

declare teams: {
    --- A player's or entity's team.
