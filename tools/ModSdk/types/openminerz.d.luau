    biome: (x: number, z: number) -> string,
    --- How many cells in a box hold a block (bounded scan).
    --- @param from One corner.
    --- @param to The opposite corner.
    --- @param block The block to count.
    --- @return The count.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    count_blocks: (from: Vec3Like, to: Vec3Like, block: any) -> number,
    --- Fills the box between two corners with one block. Large fills are spread over several ticks (a
    --- budget per tick); `on_done(job, changed)` runs when it finishes.
    --- @param from One corner.
    --- @param to The opposite corner.
    --- @param block Block to fill with.
    --- @param on_done Called with (job, cells changed).
    --- @return The job id.
    --- Runs on: server. Usable by: server mods (server VM).
    fill: (from: Vec3Like, to: Vec3Like, block: any, on_done: ((...any) -> ...any)?) -> number,
    --- Cells in a box holding a block (bounded scan).
    --- @param from One corner.
    --- @param to The opposite corner.
    --- @param block The block to look for.
    --- @param limit Most cells to return (default 64, at most 4096).
    --- @return Cell positions.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    find_blocks: (from: Vec3Like, to: Vec3Like, block: any, limit: number?) -> { any },
    --- The block in a cell: a retail name ("rock", "air") or a mod block key. On a client this is the
    --- client's own view of the world.
    --- @param position Any point inside the cell.
    --- @return Block name.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    get_block: (position: Vec3Like) -> string,
    --- Sun and torch light of a loaded cell, each 0..1.
    --- @param position The cell.
    --- @return {sun, torch} or nil when not loaded.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    light: (position: Vec3Like) -> { [any]: any }?,
    --- Cells still queued by fill/replace/structures.
    --- @return Queued cells.
    --- Runs on: server. Usable by: server mods (server VM).
    pending_edits: () -> number,
    --- The first non-air cell along a ray.
    --- @param origin Start point.
    --- @param direction Direction.
    --- @param reach Maximum distance (default 64, at most 256).
    --- @return {position, place (the cell before it), block, distance} or nil.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    raycast: (origin: Vec3Like, direction: Vec3Like, reach: number?) -> { [any]: any }?,
    --- Replaces every `find` block in the box with `replacement` (budgeted like fill).
    --- @param from One corner.
    --- @param to The opposite corner.
    --- @param find The block to look for.
    --- @param replacement What it becomes.
    --- @param on_done Called with (job, cells changed).
    --- @return The job id.
    --- Runs on: server. Usable by: server mods (server VM).
    replace: (from: Vec3Like, to: Vec3Like, find: any, replacement: any, on_done: ((...any) -> ...any)?) -> number,
    --- The world seed.
    --- @return Seed.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    seed: () -> number,
    --- Sets one cell, exactly as a player's edit: every peer sees it, the world save keeps it. A mod
    --- block is placed as its retail fallback plus its identity.
    --- @param position The cell.
    --- @param block Block name, mod key, retail id, or "air".
    --- @return True when the cell changed.
    --- Runs on: server. Usable by: server mods (server VM).
    set_block: (position: Vec3Like, block: any) -> boolean,
    --- The Y of the highest block in a column that stops a player.
    --- @param x World X.
    --- @param z World Z.
    --- @return Y, or nil for an empty column.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    surface_y: (x: number, z: number) -> number?,
}

--- Decorate newly generated chunks (ores, ruins, dungeons)
declare worldgen: {
    --- Starts offering chunks to worldgen.chunk handlers: each chunk once, the first time a player
    --- comes within `radius` chunks (default 14; retail peers see 12). What handlers build is ordinary
    --- world edits, so every peer receives it as chunk data.
    --- @param options {radius}
    --- Runs on: server. Usable by: server mods (server VM).
    enable: (options: { [any]: any }?) -> (),
    --- A repeatable random number in [0, 1) for a chunk (and a salt): the same world gives the same
    --- answer every time.
    --- @param cx Chunk X.
    --- @param cz Chunk Z.
    --- @param salt Distinguishes draws.
    --- @return 0..1.
    --- Runs on: server and client. Usable by: client mods, server mods (both VMs).
    random: (cx: number, cz: number, salt: number?) -> number,
}

