<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenMinerZ.MenusParityProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The hidden device, the content loads and the SpriteBatch recorder are
         the screens probe's; this probe only adds the front-end scenarios. -->
    <Compile Include="..\ScreensParityProbe\Program.cs" Link="Program.cs" />
    <Compile Include="..\ScreensParityProbe\Recorder.cs" Link="Recorder.cs" />
    <Compile Include="Menus.cs" />
    <None Include="..\ScreensParityProbe\App.config" Link="App.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- XNA comes from the machine's own XNA 4.0 install; nothing is copied. -->
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Run-time method hooks only; no shipped method body is changed. -->
    <PackageReference Include="HarmonyX" Version="2.10.2" />
  </ItemGroup>
</Project>
